# Smart Charge 后端环境变量配置
# 复制此文件为 .env 并填入实际值

# 高德地图 API Key（必填）
# 申请地址：https://console.amap.com/dev/key/app
AMAP_KEY=你的高德Key

# JWT 签名密钥（生产环境务必修改为随机字符串）
# 可使用 python -c "import secrets; print(secrets.token_hex(32))" 生成
JWT_SECRET_KEY=smart-charge-jwt-secret-change-in-production

# JWT 过期时间（天）
JWT_ACCESS_EXPIRE_DAYS=7
JWT_REFRESH_EXPIRE_DAYS=30
